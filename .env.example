# Reddit keys are optional: without them the server uses Reddit's public pages (about 10 requests/min).
# New apps at https://www.reddit.com/prefs/apps need Reddit's approval before they can read data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: act as your account
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=node:social-mcp:0.2.0 (by /u/your_username)

# X: bearer token from https://console.x.com (pay-per-use, billed per post read)
X_BEARER_TOKEN=
# Stop after this many post reads per UTC day (0 = no cap). 1000 reads ≈ $5.
X_DAILY_POST_LIMIT=1000

# HTTP mode (for claude.ai custom connectors)
MCP_AUTH_TOKEN=
PORT=3000

# Response cache lifetime in seconds
CACHE_TTL=60
