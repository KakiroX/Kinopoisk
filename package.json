{
  "name": "social-mcp",
  "version": "0.2.0",
  "description": "MCP server that gives Claude read access to Reddit and X: threads with full reply trees, listings, search and user history",
  "type": "module",
  "bin": {
    "social-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:http": "node dist/src/index.js --http",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
